{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "PostgresqlSettings": {
    "Host": "{PostgresqlSettings__Host}",
    "Port": "{PostgresqlSettings__Port}",
    "Database": "{PostgresqlSettings__Database}",
    "Username": "{PostgresqlSettings__Username}",
    "Password": "{PostgresqlSettings__Password}"
  },
  "Jwt": {
    "Secret": "{Jwt__Secret}",
    "Issuer": "{Jwt__Issuer}",
    "Audience": "{Jwt__Audience}",
    "AccessTokenExpirationInMinutes": 60,
    "RefreshTokenExpirationInDays": 7,
    "AbsoluteRefreshTokenExpirationInDays": 30
  },
  "Redis": {
    "Host": "{Redis__Host}",
    "Port": "{Redis__Port}",
    "Password": "{Redis__Password}"
  },
  "Minio": {
    "Endpoint": "{Minio__Endpoint}",
    "Port": 9000,
    "AccessKey": "{Minio__AccessKey}",
    "SecretKey": "{Minio__SecretKey}",
    "BucketName": "leksana-studio",
    "UseSSL": false
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Seeder": {
    "Enabled": true,
    "Disabled": []
  },
  "AllowedHosts": "*"
}
