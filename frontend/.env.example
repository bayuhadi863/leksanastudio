# Panel pengelolaan (butuh backend).
#   "on"  → panel dan layar masuk ikut dibangun; isi juga VITE_API_BASE_URL.
#   lain  → situs publik saja. Tidak ada kode panel di bundel sama sekali.
# Bawaan: tanpa panel. Deploy publik yang lupa mengisi apa pun dapat situsnya,
# bukan panel admin yang menunjuk API yang tidak ada.
VITE_PANEL=""

# Alamat dasar API backend. Kosong = http://localhost:5180/api/v1 (dev).
# Di produksi isi dengan path relatif, mis. "/api/v1", supaya tidak terikat domain.
VITE_API_BASE_URL=""

# Alamat kanonik situs. Wajib di produksi — dipakai sitemap, tautan OG, dan JSON-LD.
# Diawali VITE_ supaya ikut terbawa ke bundel peramban.
VITE_SITE_URL="https://leksana.id"

# Resend — notifikasi email untuk setiap lead yang masuk lewat formulir.
# Kosongkan saat pengembangan; endpoint kontak tetap jalan dan hanya mencatat ke log.
# Tidak berawalan VITE_ dengan sengaja: nilainya hanya dibaca di sisi server.
RESEND_API_KEY=""
RESEND_FROM="Leksana Studio <halo@leksana.id>"
RESEND_TO="halo@leksana.id"

# Fonnte — notifikasi WhatsApp ke HP. Lead yang mendarat di email saja
# dan baru dibaca besok pagi adalah lead yang hilang.
FONNTE_TOKEN=""
FONNTE_TARGET=""
