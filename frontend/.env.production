# Nilai produksi yang bukan rahasia — sengaja dikomit, supaya alamat kanonik
# situs bisa dibaca dan ditinjau di repo, bukan tersimpan sebagai keadaan di
# dasbor yang tidak muncul di mana pun saat build gagal menjelaskan dirinya.
#
# Rahasia tidak pernah masuk ke sini. Kunci Resend dan Fonnte diisi sebagai
# Environment Variables di Vercel; tanpa keduanya formulir kontak tetap menerima
# kiriman dan mencatatnya.

# Alamat yang benar-benar melayani hari ini. Ganti ke https://leksana.id begitu
# domainnya diarahkan ke proyek ini — canonical, sitemap, dan tautan OG ikut.
VITE_SITE_URL="https://leksanastudio.vercel.app"

# Panel tidak ikut dibangun untuk situs publik. Lihat plans/0005.
VITE_PANEL=""
